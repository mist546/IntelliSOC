# Copy this file to .env in the project root and adjust values as needed.
# Never commit the real .env file.

# --- Backend core ---
DATABASE_URL=sqlite:///./data/mini_soc.db
SECRET_KEY=change-this-to-a-long-random-string-in-production
# Endpoint agents each get their own unique credential (id + api_key) issued
# via POST /api/agents/register - there is no shared agent secret to set here.

# --- Ollama (local LLM, required for AI investigation) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Use 127.0.0.1, not "localhost": on Windows "localhost" resolves to IPv6 ::1
# first and Ollama only listens on IPv4, so every request pays a ~2 s
# connection-failure penalty before falling back (measured: 2.1 s vs 0.1 s).
OLLAMA_MODEL=gemma4:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=240
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_TOKENS=1300

# --- Provider: ollama_local runs OLLAMA_MODEL; ollama_cloud runs OLLAMA_CLOUD_MODEL ---
# ollama_cloud goes through the local daemon above using your `ollama signin`
# session (cloud models end in "-cloud"/":cloud"; ~5-15 s per investigation vs
# 40-90 s locally). Only if OLLAMA_CLOUD_API_KEY is set does it call
# OLLAMA_CLOUD_BASE_URL directly instead - that must be a REST key from
# ollama.com/settings/keys (NOT the ssh key `ollama signin` creates), and the
# model name then drops the suffix (gpt-oss:120b). Switchable in Settings.
LLM_PROVIDER=ollama_local
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud

# --- RAG / knowledge base ---
# CHROMA_PERSIST_DIR and KNOWLEDGE_BASE_DIR are deliberately NOT set here.
# config.py already computes both as absolute paths from the project root.
# Setting them to a relative path (even blank) overrides that default and
# resolves against the process's current working directory instead (backend/,
# since that's where uvicorn is launched from), silently pointing at a
# nonexistent/empty folder and breaking RAG. Docker overrides these
# independently in docker-compose.yml, so this doesn't affect the container
# build. If you need a custom path, use an absolute one.
RAG_TOP_K=4
# Minimum cosine similarity for a knowledge chunk to count as relevant.
RAG_MIN_SCORE=0.65
# Task prefixes for nomic-embed-text; set both empty for other embedding
# models. Changing the embedding model or prefixes requires re-indexing:
#   .\scripts\ingest_knowledge_base.ps1 -Reset
RAG_DOC_PREFIX="search_document: "
RAG_QUERY_PREFIX="search_query: "

# --- Threat intelligence (optional external providers) ---
VIRUSTOTAL_API_KEY=
NVD_API_KEY=

# --- Detection thresholds ---
SSH_BRUTE_FORCE_THRESHOLD=10
SSH_BRUTE_FORCE_WINDOW_MINUTES=5

# --- Website scanner (SSRF protection: only these hosts may be scanned) ---
SCAN_ALLOWED_HOSTS=["localhost","127.0.0.1"]
